# ExpertHub environment template — copy to .env and fill required values
NODE_ENV=production
PORT=5000
APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"
REDIS_URL=
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTO_APPROVE_USERS=true
DEV_EXPOSE_RESET_URL=false

# M-Pesa simulator by default; no real money is charged
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ExpertHub <no-reply@your-domain.example>"

DEFAULT_COMMISSION_PERCENT=20
WITHDRAWAL_HOLDING_DAYS=7
MIN_WITHDRAWAL_AMOUNT=200
